@startuml
' UC14 - Xem Course phụ trách
autonumber "<b>0.</b> "
hide footbox
skinparam backgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam LifeLineBackgroundColor white
skinparam LifeLineBorderColor black
skinparam ArrowColor black
skinparam ParticipantBorderColor black
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam BoxPadding 10
skinparam MaxMessageSize 200

' AS-IS source evidence (workspace-relative paths):
' UI: frontend/src/router.tsx:357; frontend/src/pages/instructor/my.courses.tsx:71
' API: frontend/src/services/course.service.ts:35
' Transport: frontend/src/services/axios.customize.ts:47; frontend/src/config/env.ts:13
' Local development URL: frontend/.env.development:10 (http://localhost:8080)
' Routing: gateway/api-gateway/src/main/resources/application.yml:40
' Prefix/version: services/course-service/src/main.ts:40
' Controller: services/course-service/src/modules/courses/courses.controller.ts:38
' Service: services/course-service/src/modules/courses/courses.service.ts:52
' Repository: services/course-service/src/modules/courses/courses.repository.ts:12
' Course models: services/course-service/prisma/schema.prisma:18
' REST client: services/course-service/src/infrastructure/clients/learning/learning.client.ts:30
' Client wiring/timeout: services/course-service/src/modules/courses/courses.module.ts:14
' Learning endpoint: services/learning-service/src/modules/enrollments/enrollments.controller.ts:71
' Learning query: services/learning-service/src/modules/enrollments/enrollments.service.ts:391
' Enrollment model: services/learning-service/prisma/schema.prisma:10
' Learning prefix/version: services/learning-service/src/app.setup.ts:30
' docs/source-of-truth and full BR-79/BR-287/BR-64/BR-80 definitions are absent locally.
' BR references indicate review targets, not a claim of verified specification compliance.
' Diagram scope: assigned Course list display only.
' Search/filter and pagination behavior in the shared implementation are outside this UC view.

actor Instructor
boundary "View Course Page" as Screen
participant ":ApiGateway" as Gateway
participant ":CoursesController" as CoursesController
participant ":CoursesService" as CoursesService
participant ":CoursesRepository" as CoursesRepository
participant ":EnrollmentsController" as EnrollmentsController
participant ":EnrollmentsService" as EnrollmentsService
database "course_db" as CourseDB
database "learning_db" as LearningDB

' Precondition: authenticated Instructor; local development routes through localhost:8080.
' Gateway forwards trusted user context and an internal key; routine middleware is omitted.

activate Instructor
Instructor -> Screen: Open /instructor/courses
activate Screen
Screen -> Gateway: GET /api/v1/courses
activate Gateway
Gateway -> CoursesController: GET /api/v1/courses\nTrusted userId, organizationId, role
activate CoursesController
CoursesController -> CoursesService: Load managed courses
activate CoursesService
CoursesService -> CoursesService: Verify instructor access
activate CoursesService
deactivate CoursesService

alt Access checked successfully
  ' Scope: Course.organizationId and Course.chain.instructorId.
  ' Locked and Submitted do not prevent reading.
  CoursesService -> CoursesRepository: Load assigned courses\nCurrent instructor and organization
  activate CoursesRepository
  CoursesRepository -> CourseDB: Read assigned courses
  activate CourseDB
  CourseDB -->> CoursesRepository: Course list
  deactivate CourseDB
  CoursesRepository -->> CoursesService: Course list
  deactivate CoursesRepository

  alt Courses found\nsuccessfully
    ' LearningClient is a hidden HTTP adapter, not a lifeline.
    ' Direct REST to LEARNING_SERVICE_URL; internal key and trusted user headers.
    ' The POST reads counts and does not create enrollments.
    CoursesService -> EnrollmentsController: POST /api/v1/enrollments/learner-counts\nCourse IDs and user context
    activate EnrollmentsController
    alt Counts loaded\nsuccessfully
      EnrollmentsController -> EnrollmentsService: Load learner counts
      activate EnrollmentsService
      EnrollmentsService -> EnrollmentsService: Verify organization access
      activate EnrollmentsService
      deactivate EnrollmentsService
      EnrollmentsService -> LearningDB: Count InProgress learners by course\nCurrent organization
      activate LearningDB
      LearningDB -->> EnrollmentsService: Learner counts
      deactivate LearningDB
      EnrollmentsService -->> EnrollmentsController: Learner counts
      deactivate EnrollmentsService
      EnrollmentsController -->> CoursesService: 201 Created\nLearner counts
      deactivate EnrollmentsController
      CoursesService -->> CoursesController: Courses with learner counts
      deactivate CoursesService
      CoursesController -->> Gateway: 200 OK - course list
      deactivate CoursesController
      Gateway -->> Screen: Course list
      deactivate Gateway
      Screen -->> Instructor: Show managed courses
    else Learner count\nloading failed
      ' Restore caller activations for this alternative.
      activate Gateway
      activate CoursesController
      activate CoursesService
      activate EnrollmentsController
      ' Same REST attempt: non-2xx response, transport failure or 5000 ms timeout.
      ' No successful downstream DB execution, cancellation or reply is assumed.
      deactivate EnrollmentsController
      CoursesService -->> CoursesController: Service unavailable (503)
      deactivate CoursesService
      CoursesController -->> Gateway: 503 Service Unavailable
      deactivate CoursesController
      Gateway -->> Screen: Load error
      deactivate Gateway
      Screen -->> Instructor: Show load error and Retry
    end
  else Empty list returned\nsuccessfully
    ' Restore caller activations for this alternative.
    activate Gateway
    activate CoursesController
    activate CoursesService
    ' No Course IDs: skip the REST request and use an empty learner-count list.
    CoursesService -->> CoursesController: Empty course list
    deactivate CoursesService
    CoursesController -->> Gateway: 200 OK - empty list
    deactivate CoursesController
    Gateway -->> Screen: Empty course list
    deactivate Gateway
    Screen -->> Instructor: Show "No Courses yet"
  end
else Access\ncheck failed
  ' Restore caller activations for this alternative.
  activate Gateway
  activate CoursesController
  activate CoursesService
  CoursesService -->> CoursesController: Access denied (403)
  deactivate CoursesService
  CoursesController -->> Gateway: 403 Forbidden
  deactivate CoursesController
  Gateway -->> Screen: Access error
  deactivate Gateway
  Screen -->> Instructor: Show load error and Retry
end
deactivate Screen
deactivate Instructor

' AS-IS: missing learner groups default to zero; only InProgress enrollments are counted.
' Results are Course versions without latest-version selection or chain grouping.
' A learner-count failure prevents partial results; the UI clears its list and stops loading.
' Fields: name, versionNumber, courseType, status, locked and learnerCount.
' Read-only: no TenantClient, storage, Kafka or data writes.
@enduml
