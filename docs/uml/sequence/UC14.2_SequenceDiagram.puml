@startuml
' UC14.2 - Tạo Course
autonumber "<b>0.</b> "
hide footbox
skinparam backgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam LifeLineBackgroundColor white
skinparam LifeLineBorderColor black
skinparam ArrowColor black
skinparam ParticipantBorderColor black
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam BoxPadding 10
skinparam MaxMessageSize 200

' AS-IS evidence; paths are relative to the workspace root.
' UI: frontend/src/pages/instructor/course.create.tsx:78 (handleCreate)
' Optional selection/preview only: same file:61 (beforeUpload returns false).
' API wrappers: frontend/src/services/course.service.ts:43 and :46
' Transport: frontend/src/services/axios.customize.ts:47 and :64
' URL selection: frontend/src/config/env.ts:13; frontend/.env.development:10
' Gateway route: gateway/api-gateway/src/main/resources/application.yml:40
' NestJS prefix/version: services/course-service/src/main.ts:40
' Controller: services/course-service/src/modules/courses/courses.controller.ts:44 and :67
' Service: services/course-service/src/modules/courses/courses.service.ts:164 and :592
' Repository: services/course-service/src/modules/courses/courses.repository.ts:53 and :375
' Models: services/course-service/prisma/schema.prisma:18, :31 and :126
' Provider selection: services/course-service/src/infrastructure/storage/storage.provider.ts:31
' Provider: libraries/ts-storage/src/providers/cloudinary/cloudinary.provider.ts:31 and :61
' File validation: libraries/ts-storage/src/validators/file.validator.ts:7
' Demo quota entry gate only: frontend/src/pages/instructor/my.courses.tsx:122
' Demo quota definition: frontend/src/components/instructor/instructor.data.ts:495
' docs/source-of-truth and full BR-1/49/50/73/290/288 definitions are absent locally.
' Reference intent: docs/architecture/source-of-truth-migration-plan.md:180.

actor Instructor
boundary "Create Course Page" as Screen
participant ":ApiGateway" as Gateway
participant ":CoursesController" as Controller
participant ":CoursesService" as Service
participant ":CoursesRepository" as Repository
participant ":CloudinaryStorageProvider" as Storage
participant "Cloudinary" as Cloudinary
database "course_db" as CourseDB

' Precondition: authenticated Instructor; local Course API base URL is localhost:8080.
' Gateway forwards trusted user context and an internal key; routine middleware is omitted.

activate Instructor
Instructor -> Screen: Open /instructor/courses/create
activate Screen
Instructor -> Screen: Enter course details and optional cover
Instructor -> Screen: Click Create Draft
Screen -> Screen: Validate course details
activate Screen
deactivate Screen

alt Form validated successfully
  opt Cover selected
    Screen -> Gateway: POST /api/v1/courses/cover\nCover file
    activate Gateway
    Gateway -> Controller: POST /api/v1/courses/cover\nTrusted user context
    activate Controller
    Controller -> Service: Upload course cover
    activate Service

    ' This outcome-level alternative summarizes the upload operation.
    ' Its successful trace expands storage and metadata work.
    ' Failed validation/provider/persistence work is not replayed as successful calls.
    alt Cover uploaded successfully
      Service -> Storage: Upload cover image
      activate Storage
      Storage -> Cloudinary: Upload image
      activate Cloudinary
      Cloudinary -->> Storage: Stored image
      deactivate Cloudinary
      Storage -->> Service: Stored image
      deactivate Storage
      Service -> Repository: Save cover metadata
      activate Repository
      Repository -> CourseDB: Insert cover metadata\nCurrent organization
      activate CourseDB
      CourseDB -->> Repository: Cover metadata
      deactivate CourseDB
      Repository -->> Service: Cover file ID and URL
      deactivate Repository
    else Cover upload failed
      ' Access, missing-file, image-validation and provider failures are grouped here.
      ' Framework multipart rejection happens before Service and is omitted from this trace.
      opt Image stored but metadata save failed
        Service -> Storage: Delete uploaded cover
        activate Storage
        Storage -> Cloudinary: Delete image
        activate Cloudinary
        Cloudinary -->> Storage: Deletion result or error
        deactivate Cloudinary
        Storage -->> Service: Cleanup result or error
        deactivate Storage
        ' Best-effort cleanup preserves the original metadata persistence error.
      end
    end
    Service -->> Controller: Cover details or upload error
    deactivate Service
    Controller -->> Gateway: 201 Created or upload error
    deactivate Controller
    Gateway -->> Screen: Cover details or upload error
    deactivate Gateway
  end

  ' A skipped upload and a completed upload converge here.
  ' Ready means no cover was selected OR upload returned valid cover details.
  ' Failed/rejected upload or missing response data cannot enter the create branch.
  alt Cover prepared successfully
    Screen -> Gateway: POST /api/v1/courses\nCourse details and optional coverFileId
    activate Gateway
    Gateway -> Controller: POST /api/v1/courses\nTrusted user context
    activate Controller
    Controller -> Service: Create Draft Course
    activate Service
    Service -> Service: Check Instructor access
    activate Service
    deactivate Service
    ' Role and organization checks execute before persistence; there is no quota lookup.
    ' The successful trace expands the atomic create; the failure trace groups access
    ' rejection (no writes) and persistence failure (transaction rollback).
    alt Draft created successfully
      Service -> Repository: Save Draft Course
      activate Repository
      Repository -> CourseDB: Create CourseChain and Course\nSingle transaction
      activate CourseDB
      CourseDB -->> Repository: Draft Course
      deactivate CourseDB
      Repository -->> Service: Draft Course
      deactivate Repository
      Service -->> Controller: Draft Course
      deactivate Service
      Controller -->> Gateway: 201 Created
      deactivate Controller
      Gateway -->> Screen: Draft Course
      deactivate Gateway
      Screen -->> Instructor: Show "Draft Course created."
      Screen -> Screen: Open Course Builder
      activate Screen
      deactivate Screen
    else Course creation failed
      ' Restore the same incoming executions for PlantUML's next operand.
      activate Gateway
      activate Controller
      activate Service
      Service -->> Controller: Access or persistence error
      deactivate Service
      Controller -->> Gateway: 403 Forbidden or 500 error
      deactivate Controller
      Gateway -->> Screen: Create error
      deactivate Gateway
      Screen -->> Instructor: Show create error
    end
  else Cover preparation failed
    Screen -->> Instructor: Show upload error
  end
else Form validation failed
  Screen -->> Instructor: Show form error
end
deactivate Screen
deactivate Instructor

' Validation is form.validateFields(); a rejection enters handleCreate's existing catch.
' The finally block always stops loading. Required: name, expectedCompletionDays, courseType.
' Selecting a cover creates a preview; upload starts only after Create Draft.
' The entry-page quota gate uses demo data; handleCreate performs no subscription check.
' Missing upload response data or a rejected upload prevents Course creation.
' Metadata: purpose=CourseCover, status=Ready and provider storage fields.
' Course response: locked=false, learnerCount=0; lockedAt omitted.
' Upload and creation are separate; later creation failure does not clean up the cover.
' Cover access requires INSTRUCTOR and organizationId; missing/invalid image is rejected.
' Cover validation: at most 5 MiB; JPEG, PNG or WebP.
' Upload errors: 400/403/503/500; multipart middleware may also reject with 413.
' Course creation failure never cleans up an already committed cover.
' Remote Cloudinary credentials remain unverified.
' No MinIO, presigned URL, TenantClient, LearningClient, Kafka or approval submission.
' Success opens /instructor/courses/{id}/builder; no CourseDraftCreated handler.
@enduml
