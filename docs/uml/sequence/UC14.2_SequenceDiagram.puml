@startuml
title UC14.2 - Tạo Course
autonumber
hide footbox
skinparam backgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam LifeLineBackgroundColor white
skinparam LifeLineBorderColor black
skinparam ArrowColor black
skinparam ParticipantBorderColor black
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 25
skinparam BoxPadding 10
skinparam MaxMessageSize 80

' AS-IS evidence; paths are relative to the workspace root.
' UI: frontend/src/pages/instructor/course.create.tsx:78 (handleCreate)
' Optional selection/preview only: same file:61 (beforeUpload returns false).
' API wrappers: frontend/src/services/course.service.ts:43 and :46
' Transport: frontend/src/services/axios.customize.ts:47 and :64
' URL selection: frontend/src/config/env.ts:13; frontend/.env.development:10
' Gateway route: gateway/api-gateway/src/main/resources/application.yml:40
' NestJS prefix/version: services/course-service/src/main.ts:40
' Controller: services/course-service/src/modules/courses/courses.controller.ts:44 and :67
' Service: services/course-service/src/modules/courses/courses.service.ts:164 and :592
' Repository: services/course-service/src/modules/courses/courses.repository.ts:53 and :375
' Models: services/course-service/prisma/schema.prisma:18, :31 and :126
' Provider selection: services/course-service/src/infrastructure/storage/storage.provider.ts:31
' Provider: libraries/ts-storage/src/providers/cloudinary/cloudinary.provider.ts:31 and :61
' File validation: libraries/ts-storage/src/validators/file.validator.ts:7
' Demo quota entry gate only: frontend/src/pages/instructor/my.courses.tsx:122
' Demo quota definition: frontend/src/components/instructor/instructor.data.ts:495
' docs/source-of-truth and full BR-1/49/50/73/290/288 definitions are absent locally.
' Reference intent: docs/architecture/source-of-truth-migration-plan.md:180.

actor Instructor
boundary "CourseCreate\n(instructor/course.create.tsx)" as Screen
participant "API Gateway" as Gateway
participant ":CoursesController" as Controller
participant ":CoursesService" as Service
participant ":CoursesRepository" as Repository
database "course_db" as CourseDB
participant ":CloudinaryStorageProvider" as Storage
participant "Cloudinary" as Cloudinary

note over Instructor, Gateway
  Precondition: authenticated session with a valid JWT; React route requires INSTRUCTOR.
  Scope: local development configuration, VITE_COURSE_BACKEND_URL=http://localhost:8080.
  Gateway forwards trusted user context and an internal key, without rewriting the path.
  Form validation and routine middleware are omitted.
end note

activate Instructor
Instructor -> Screen: Open /instructor/courses/create
activate Screen
Instructor -> Screen: Enter name, expectedCompletionDays and courseType\nOptionally enter Draft details and select a cover
note right of Screen
  shortDescription, trainingObjectives and learningOutcomes are optional.
  Selecting a cover creates a local preview; it does not upload immediately.
  MyCourses entry uses a static demo quota gate, not Subscription data.
  Direct access to this form and handleCreate have no quota check.
end note
Instructor -> Screen: Click Create Draft
Screen -> Screen: handleCreate(): validateFields(); setCreating(true)

opt A cover is selected
  Screen -> Gateway: POST /api/v1/courses/cover\nuploadCourseCoverAPI(file), multipart field "file"
  activate Gateway
  Gateway -> Controller: POST /api/v1/courses/cover\nTrusted user context
  activate Controller
  alt Multipart file exceeds 5 MiB
    Controller -> Controller: FileInterceptor rejects with HTTP 413\nHandler is not invoked
  else Multipart request accepted
    Controller -> Service: uploadCover(user, file)
    activate Service
    alt Role is not INSTRUCTOR or organizationId is empty
      Service -> Service: Throw ForbiddenException (403)
    else File is missing
      Service -> Service: Throw BadRequestException (400)
    else Authorized upload with a file
      Service -> Storage: upload(file buffer, options)\nfolder=learnup/{organizationId}/courses/covers\nresourceType=image; max 5 MiB; JPEG/PNG/WebP
      activate Storage
      Storage -> Storage: Validate non-empty file, filename, size and MIME type
      alt File validation fails
        Storage -> Storage: Throw StorageValidationError
      else File validation passes
        Storage -> Cloudinary: upload_stream(options); stream.end(file.buffer)\nAwait completed SDK result
        activate Cloudinary
        Cloudinary -->> Storage: Completed image result or upload error
        deactivate Cloudinary
        Storage -> Storage: Map result to IStoredFile\nor throw StorageProviderError
      end
      Storage -->> Service: IStoredFile or storage exception
      deactivate Storage

      alt Storage upload succeeded
        Service -> Repository: createCourseCoverMediaFile(user.organizationId, storedFile)
        activate Repository
        Repository -> CourseDB: Prisma mediaFile.create\norganizationId=user.organizationId\npurpose=CourseCover; status=Ready; storage metadata
        activate CourseDB
        CourseDB -->> Repository: MediaFile metadata or database error
        deactivate CourseDB
        Repository -->> Service: MediaFile metadata or propagated database error
        deactivate Repository
        alt MediaFile was saved
          Service -> Service: Prepare fileId, secure URL, filename, MIME type and size
        else Metadata persistence failed
          Service -> Storage: delete(storedFile.storageKey, resourceType)
          activate Storage
          Storage -> Cloudinary: uploader.destroy(storageKey, options)
          activate Cloudinary
          Cloudinary -->> Storage: Delete result or error
          deactivate Cloudinary
          Storage -->> Service: Completion or delete exception
          deactivate Storage
          Service -> Service: Ignore cleanup failure; rethrow original database error
        end
      else Storage upload failed
        Service -> Service: StorageValidationError becomes HTTP 400\nStorageProviderError becomes HTTP 503
      end
    end
    Service -->> Controller: Upload result or propagated exception
    deactivate Service
  end
  Controller -->> Gateway: 201 {data:{fileId,url,...}}\nor HTTP 400 / 403 / 413 / 503 / 500
  deactivate Controller
  Gateway -->> Screen: Forward upload HTTP response\nAxios exposes response body
  deactivate Gateway
  note right of Screen
    If uploadResponse.data is absent, handleCreate shows an upload error and returns.
    A rejected upload promise enters catch; neither path calls createCourseAPI.
  end note
end

alt No cover selected or cover upload succeeded
  Screen -> Screen: Trim values and remove blank learningOutcomes\nSet coverFileId from upload, if any
  Screen -> Gateway: POST /api/v1/courses\ncreateCourseAPI(payload), Bearer JWT
  activate Gateway
  Gateway -> Controller: POST /api/v1/courses\nTrusted userId, organizationId and role
  activate Controller
  Controller -> Service: create(user, dto)
  activate Service
  alt Role is not INSTRUCTOR or organizationId is empty
    Service -> Service: Throw ForbiddenException (403)
  else Instructor with organization context
    Service -> Service: Normalize optional details to null / []\nForce status=Draft
    note right of Service
      No Subscription lookup, status check or Course-chain quota check executes.
      No quota lock, quota reservation or concurrent quota enforcement executes.
      coverFileId is UUID-validated but not checked for tenant, purpose or status here.
    end note
    Service -> Repository: createCourse(data)\norganizationId=user.organizationId; instructorId=user.userId
    activate Repository
    Repository -> CourseDB: Prisma $transaction: create CourseChain, then Course\nChain owner=user.userId; both organizationId=user.organizationId\nCourse versionNumber=1; status=Draft; lockedAt=null
    activate CourseDB
    CourseDB -->> Repository: Created Course or transaction error\nRollback both inserts on failure
    deactivate CourseDB
    Repository -->> Service: Selected Course fields or propagated database error
    deactivate Repository
    alt Transaction succeeded
      Service -> Service: Remove lockedAt; add locked=false and learnerCount=0
    else Transaction failed
      Service -> Service: Propagate database error
    end
  end
  Service -->> Controller: Created Course or propagated exception
  deactivate Service
  Controller -->> Gateway: 201 {statusCode,message,data:Course}\nor HTTP 403 / 500
  deactivate Controller
  Gateway -->> Screen: Forward create HTTP response\nAxios exposes response body
  deactivate Gateway
  alt response.data contains the created Course
    Screen -->> Instructor: Show "Draft Course created."
    Screen -> Screen: navigate(/instructor/courses/{id}/builder)
  else No response.data or request rejected
    Screen -->> Instructor: Show create error; remain on the form
  end
else Cover upload failed
  Screen -->> Instructor: Show upload error or generic create error\nDo not send POST /api/v1/courses
end
Screen -> Screen: finally: setCreating(false)
deactivate Screen
deactivate Instructor

note over Screen, Cloudinary
  Upload and Course creation are separate operations.
  If upload succeeds but Course creation fails, this flow does not clean up the cover.
  Local Cloudinary configuration is non-empty; remote credential validity is unverified.
  No MinIO, presigned URL, TenantClient, LearningClient, Kafka or approval submission executes.
  The new Course is Draft and unlocked; existing-course Locked/Submitted checks do not apply.
  Successful creation opens the Builder; CourseDraftCreated is not used by handleCreate.
end note
@enduml
