@startuml
' UC14.2 - Tạo Course
autonumber "<b>0.</b> "
hide footbox
skinparam backgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam LifeLineBackgroundColor white
skinparam LifeLineBorderColor black
skinparam ArrowColor black
skinparam ParticipantBorderColor black
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 25
skinparam BoxPadding 10
skinparam MaxMessageSize 80

' AS-IS evidence; paths are relative to the workspace root.
' UI: frontend/src/pages/instructor/course.create.tsx:78 (handleCreate)
' Optional selection/preview only: same file:61 (beforeUpload returns false).
' API wrappers: frontend/src/services/course.service.ts:43 and :46
' Transport: frontend/src/services/axios.customize.ts:47 and :64
' URL selection: frontend/src/config/env.ts:13; frontend/.env.development:10
' Gateway route: gateway/api-gateway/src/main/resources/application.yml:40
' NestJS prefix/version: services/course-service/src/main.ts:40
' Controller: services/course-service/src/modules/courses/courses.controller.ts:44 and :67
' Service: services/course-service/src/modules/courses/courses.service.ts:164 and :592
' Repository: services/course-service/src/modules/courses/courses.repository.ts:53 and :375
' Models: services/course-service/prisma/schema.prisma:18, :31 and :126
' Provider selection: services/course-service/src/infrastructure/storage/storage.provider.ts:31
' Provider: libraries/ts-storage/src/providers/cloudinary/cloudinary.provider.ts:31 and :61
' File validation: libraries/ts-storage/src/validators/file.validator.ts:7
' Demo quota entry gate only: frontend/src/pages/instructor/my.courses.tsx:122
' Demo quota definition: frontend/src/components/instructor/instructor.data.ts:495
' docs/source-of-truth and full BR-1/49/50/73/290/288 definitions are absent locally.
' Reference intent: docs/architecture/source-of-truth-migration-plan.md:180.

actor Instructor
boundary "Create Course Page" as Screen
participant ":ApiGateway" as Gateway
participant ":CoursesController" as Controller
participant ":CoursesService" as Service
participant ":CoursesRepository" as Repository
participant ":CloudinaryStorageProvider" as Storage
participant "Cloudinary" as Cloudinary
database "course_db" as CourseDB

' Precondition: authenticated Instructor; local Course API base URL is localhost:8080.
' Gateway forwards trusted user context and an internal key; routine middleware is omitted.

activate Instructor
Instructor -> Screen: Open /instructor/courses/create
activate Screen
Instructor -> Screen: Enter course details and optional cover
' Required: name, expectedCompletionDays and courseType; other draft details are optional.
' Cover selection creates a local preview. Upload occurs only after Create Draft is clicked.
' The entry-page quota gate is static demo data; handleCreate has no subscription quota check.
Instructor -> Screen: Click Create Draft
Screen -> Screen: Validate course details

opt A cover is selected
  Screen -> Gateway: POST /api/v1/courses/cover\nCover file
  activate Gateway
  Gateway -> Controller: POST /api/v1/courses/cover\nTrusted user context
  activate Controller
  alt Multipart upload failed - file too large
    Controller -> Controller: Reject file (413)
  else Multipart upload accepted successfully
    Controller -> Service: Upload course cover
    activate Service
    alt Upload access check failed
      Service -> Service: Reject access (403)
    else Upload validation failed - missing file
      Service -> Service: Reject missing file (400)
    else Upload request validated successfully
      Service -> Storage: Upload cover image
      ' Cover validation: image resource; at most 5 MiB; JPEG, PNG or WebP.
      ' Destination: learnup/{organizationId}/courses/covers.
      activate Storage
      Storage -> Storage: Validate image file
      alt Image validation failed
        Storage -> Storage: Reject invalid image
      else Image validated successfully
        Storage -> Cloudinary: Upload image
        activate Cloudinary
        Cloudinary -->> Storage: Stored image or error
        deactivate Cloudinary
        Storage -> Storage: Prepare upload result
      end
      Storage -->> Service: Stored file or error
      deactivate Storage

      alt Image uploaded successfully
        Service -> Repository: Save cover metadata
        activate Repository
        Repository -> CourseDB: Insert cover metadata\nCurrent organization
        activate CourseDB
        CourseDB -->> Repository: Cover metadata or error
        deactivate CourseDB
        Repository -->> Service: Cover metadata or error
        deactivate Repository
        alt Cover metadata saved successfully
          Service -> Service: Prepare cover file ID and URL
        else Cover metadata saving failed
          Service -> Storage: Delete uploaded cover
          activate Storage
          Storage -> Cloudinary: Delete image
          activate Cloudinary
          Cloudinary -->> Storage: Deletion result or error
          deactivate Cloudinary
          Storage -->> Service: Cleanup result or error
          deactivate Storage
          Service -> Service: Propagate metadata error
          ' Cleanup is best-effort; its failure does not replace the original database error.
        end
      else Image upload failed
        Service -> Service: Report upload error (400 / 503)
      end
    end
    Service -->> Controller: Cover details or error
    deactivate Service
  end
  Controller -->> Gateway: 201 Created - cover details\nor upload error
  deactivate Controller
  Gateway -->> Screen: Cover details or error
  deactivate Gateway
  ' Missing response data or a rejected upload prevents the subsequent create request.
end

alt Cover preparation completed successfully
  ' Includes both no cover selected and an uploaded cover with response data.
  Screen -> Screen: Prepare course data
  Screen -> Gateway: POST /api/v1/courses\nCourse details
  activate Gateway
  Gateway -> Controller: POST /api/v1/courses\nTrusted userId, organizationId and role
  activate Controller
  Controller -> Service: Create Draft Course
  activate Service
  alt Instructor access check failed
    Service -> Service: Reject access (403)
  else Instructor access checked successfully
    Service -> Service: Set Draft status
    ' No subscription/quota lookup, lock or reservation executes here.
    ' coverFileId is UUID-validated; tenant, purpose and status are not checked here.
    Service -> Repository: Save Draft Course
    activate Repository
    Repository -> CourseDB: Create CourseChain and Course\nSingle transaction
    ' Current organization and instructor; versionNumber=1, status=Draft, lockedAt=null.
    activate CourseDB
    CourseDB -->> Repository: Draft Course or transaction error
    ' A failed transaction rolls back both inserts.
    deactivate CourseDB
    Repository -->> Service: Draft Course or error
    deactivate Repository
    alt Draft Course saved successfully
      Service -> Service: Prepare created Course
      ' Response has locked=false and learnerCount=0, without lockedAt.
    else Transaction failed
      Service -> Service: Report save error
    end
  end
  Service -->> Controller: Draft Course or error
  deactivate Service
  Controller -->> Gateway: 201 Created - Draft Course\nor 403 / 500 error
  deactivate Controller
  Gateway -->> Screen: Draft Course or error
  deactivate Gateway
  alt Draft Course created successfully
    Screen -->> Instructor: Show "Draft Course created."
    Screen -> Screen: Open Course Builder
  else Draft Course creation failed
    Screen -->> Instructor: Show create error
  end
else Cover upload failed
  Screen -->> Instructor: Show upload error
end
Screen -> Screen: Stop loading
deactivate Screen
deactivate Instructor

' Upload and creation are separate operations; a later creation failure does not clean up the cover.
' Cover metadata is saved with purpose=CourseCover, status=Ready and provider storage metadata.
' Local Cloudinary configuration is non-empty; remote credential validity remains unverified.
' No MinIO, presigned URL, TenantClient, LearningClient, Kafka or approval submission executes.
' Success opens /instructor/courses/{id}/builder; CourseDraftCreated is not used by handleCreate.
@enduml
