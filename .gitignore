# ==============================================================================
# LearnUP Platform .gitignore
# ==============================================================================

# --------------------------------------------------
# Environment, Secrets & Local Overrides
# --------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.keystore

# --------------------------------------------------
# Java & Maven
# --------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml

# Compiled Class files
*.class

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --------------------------------------------------
# Node.js, TypeScript & Package Managers
# --------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.pnpm-store/

# Build and Compilation Outputs
dist/
build/
out/
.tsbuildinfo

# --------------------------------------------------
# Next.js & Frontend Tooling
# --------------------------------------------------
.next/
.turbo/
.vercel/

# --------------------------------------------------
# Testing & Coverage
# --------------------------------------------------
coverage/
.nyc_output/
*.lcov
*.log
logs/

# --------------------------------------------------
# IDEs & Code Editors
# --------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.built-jar-path

# Sublime Text
*.sublime-workspace
*.sublime-project

# --------------------------------------------------
# Operating System & Temporary Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.swp
*~

