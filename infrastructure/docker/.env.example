# ==============================================================================
# LearnUP Local Development Environment Variables
# ==============================================================================

# Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
EUREKA_PORT=8761
GATEWAY_PORT=8000
IDENTITY_PORT=8081

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learnup_identity

# JWT Secret (Must be >= 256 bits for HMAC-SHA256)
JWT_SECRET=learnup_super_secret_jwt_signing_key_2026_enterprise_platform_token

# Environment Profile
SPRING_PROFILES_ACTIVE=dev
NODE_ENV=development
