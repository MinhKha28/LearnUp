# Gateway Backend URL (Default local development)
VITE_API_BASE_URL=http://localhost:8080

# Delivery milestone (1 | 2 | 3) whose menu items and routes are shown. Missing or invalid → 1.
# To work on a later milestone's features, set it in .env.local (not committed), e.g. VITE_MILESTONE=2
VITE_MILESTONE=1

# MSW mocks, development only (src/mocks, docs/api-contracts.md). "true" mocks the endpoints the
# backend does not have yet; everything else still goes to VITE_API_BASE_URL.
VITE_USE_MOCKS=false
# Also mock endpoints the backend already has (comma-separated groups), e.g. auth — to work offline.
VITE_MOCKS_INCLUDE=
