VITE_BACKEND_URL=http://localhost:8080

# TẠM THỜI (UC12): fake danh tính khi tenant-service chưa đi qua api-gateway được.
# Khi dùng: đặt VITE_BACKEND_URL=http://localhost:8084 trong .env.development.local (gọi thẳng tenant),
# backend bật DEV_FAKE_AUTH=true. Để trống = backend dùng Organizer mặc định của seed (Lan).
# Ví dụ Organizer công ty XYZ: 01900000-0000-7000-8000-00000000b010
VITE_DEV_FAKE_USER_ID=

# Proxy danh tính dev cho 6 UC learner (D37). Đặt trong .env.development.local, không commit.
# Bật proxy (chỉ khi chạy vite dev, dev server chỉ nghe localhost); cờ VITE_ là cờ phía trình duyệt, không bí mật.
DEV_IDENTITY_PROXY=
VITE_DEV_IDENTITY_PROXY=
# Bắt buộc khi bật: trùng INTERNAL_SERVICE_KEY của course-service và learning-service.
DEV_INTERNAL_SERVICE_KEY=
# Mặc định http://localhost:8083 và http://localhost:8085.
DEV_COURSE_SERVICE_URL=
DEV_LEARNING_SERVICE_URL=
# LEARNER_1 (mặc định), LEARNER_2 hoặc LEARNER_3; đổi lúc chạy bằng khung chọn danh tính.
DEV_PROXY_LEARNER=
