# Base URL dùng chung cho các service chưa có biến riêng: identity-service (8081) và phần learner
# (catalog -> course-service 8083, enrollments -> learning-service 8085). Qua api-gateway: http://localhost:8080.
VITE_BACKEND_URL=http://localhost:8080

# Base URL riêng của từng backend service, dạng VITE_<TÊN_SERVICE>_BACKEND_URL. Bắt buộc đủ cả 3 biến.
# Khi đi qua api-gateway thì đặt cả 3 biến = địa chỉ của gateway (http://localhost:8080 khi chạy gateway riêng,
# http://localhost:8088 khi chạy bằng Docker Compose, cổng GATEWAY_HOST_PORT). Riêng assessment-service luôn phải đi qua gateway.
# tenant-service (8084): gói, đăng ký Organization, Instructor/Learner, lời mời (UC01-04, UC12, UC13)
VITE_TENANT_BACKEND_URL=http://localhost:8084
# course-service (8083 theo services/course-service/.env; docker-compose map 8089): Course, cấu trúc Course (UC18, UC19)
VITE_COURSE_BACKEND_URL=http://localhost:8083
# assessment-service: Assignment, Quiz, Peer Review (UC18, UC19). KHÔNG trỏ thẳng vào cổng 8086: trình duyệt không còn gửi
# header danh tính nội bộ (x-internal-key, x-user-id...), danh tính do api-gateway chèn từ JWT, nên gọi thẳng
# assessment-service trả 401 cho mọi lời gọi. Đặt địa chỉ của api-gateway (xem trên). Ai đã có file .env.development.local
# cũ trỏ vào 8086 thì phải đổi dòng này rồi khởi động lại Vite.
VITE_ASSESSMENT_BACKEND_URL=http://localhost:8080

# TẠM THỜI (UC12): fake danh tính khi tenant-service chưa đi qua api-gateway được.
# Khi dùng: VITE_TENANT_BACKEND_URL trỏ thẳng tenant (http://localhost:8084),
# backend bật DEV_FAKE_AUTH=true. Để trống = backend dùng Organizer mặc định của seed (Lan).
# Ví dụ Organizer công ty XYZ: 01900000-0000-7000-8000-00000000b010
VITE_DEV_FAKE_USER_ID=

# Proxy danh tính dev cho 6 UC learner (D37). Đặt trong .env.development.local, không commit.
# Bật proxy (chỉ khi chạy vite dev, dev server chỉ nghe localhost); cờ VITE_ là cờ phía trình duyệt, không bí mật.
DEV_IDENTITY_PROXY=
VITE_DEV_IDENTITY_PROXY=
# Bắt buộc khi bật: trùng INTERNAL_SERVICE_KEY của course-service và learning-service.
DEV_INTERNAL_SERVICE_KEY=
# Mặc định http://localhost:8083 và http://localhost:8085.
DEV_COURSE_SERVICE_URL=
DEV_LEARNING_SERVICE_URL=
# LEARNER_1 (mặc định), LEARNER_2 hoặc LEARNER_3; đổi lúc chạy bằng khung chọn danh tính.
DEV_PROXY_LEARNER=
