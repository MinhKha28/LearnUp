{
  "name": "@learnup/ts-storage",
  "version": "1.0.0",
  "description": "Framework-neutral storage abstraction and Cloudinary provider for LearnUP TypeScript services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "cloudinary": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.7.3",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
