PORT=8087
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/achievement_reporting_db?schema=public"
INTERNAL_SERVICE_KEY=learnup-internal-secret
CERTIFICATE_CONSUMER_ENABLED=false
KAFKA_BROKERS=localhost:9092
TENANT_SERVICE_URL=http://localhost:8082
COURSE_SERVICE_URL=http://localhost:8083
CERTIFICATE_PROFILE_CLIENT_MODE=http
CERTIFICATE_COURSE_CLIENT_MODE=http
CERTIFICATE_CONCURRENCY=4
CERTIFICATE_LEASE_MS=120000
CERTIFICATE_POLL_MS=1000
CERTIFICATE_HTTP_TIMEOUT_MS=5000
CERTIFICATE_LOGO_MAX_BYTES=2097152
CERTIFICATE_LOGO_HOSTS=res.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Signer writes require Tenant access; fake is permitted only in development/test.
CERTIFICATE_SIGNER_ACCESS_CLIENT_MODE=http
# Omit CERTIFICATE_CLEANUP_ENABLED to inherit CERTIFICATE_CONSUMER_ENABLED.
# CERTIFICATE_CLEANUP_ENABLED=true
CERTIFICATE_CLEANUP_DELAY_MS=600000
CERTIFICATE_CLEANUP_POLL_MS=1000
CERTIFICATE_CLEANUP_LEASE_MS=120000
CERTIFICATE_CLEANUP_WARN_SECONDS=3600
