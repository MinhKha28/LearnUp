generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Certificate {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  enrollmentId    String    @unique @map("enrollment_id") @db.Uuid
  learnerId       String    @map("learner_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  certificateCode String    @unique @map("certificate_code") @db.VarChar(12)
  status          String    @default("Pending")
  issuedAt        DateTime  @map("issued_at") @db.Timestamptz
  completedLate   Boolean   @map("completed_late")
  scoreSnapshot   Json      @map("score_snapshot")
  learnerName     String?   @map("learner_name") @db.VarChar(100)
  courseName      String?   @map("course_name") @db.VarChar(200)
  versionNumber   Int?      @map("version_number")
  chainId         String?   @map("chain_id") @db.Uuid
  completionFingerprint String @map("completion_fingerprint") @db.VarChar(64)
  organizationTimezone String? @map("organization_timezone") @db.Text
  organizationName String? @map("organization_name") @db.VarChar(200)
  logoAssetKey String? @map("logo_asset_key")
  logoHash String? @map("logo_hash") @db.VarChar(64)
  logoMime String? @map("logo_mime")
  logoSize Int? @map("logo_size")
  signerName String? @map("signer_name") @db.VarChar(100)
  signerTitle String? @map("signer_title") @db.VarChar(200)
  signatureAssetKey String? @map("signature_asset_key")
  signatureHash String? @map("signature_hash") @db.VarChar(64)
  signatureMime String? @map("signature_mime")
  issuedRecordedAt DateTime? @map("issued_recorded_at") @db.Timestamptz
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  issueAttempts   Int       @default(0) @map("issue_attempts")
  nextAttemptAt   DateTime? @map("next_attempt_at") @db.Timestamptz
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  evaluationForm EvaluationForm?
  completionEvents ProcessedCompletionEvent[]

  @@unique([learnerId, courseId])
  @@index([organizationId, courseId])
  @@index([organizationId, learnerId], map: "ix_certificates_org_learner_issued", where: raw("status = 'Issued'"))
  @@index([courseId], map: "ix_certificates_course_issued", where: raw("status = 'Issued'"))
  @@index([organizationId, issuedAt], map: "ix_certificates_org_issued", where: raw("status = 'Issued'"))
  @@index([nextAttemptAt, id], map: "ix_certificates_retry", where: raw("status = 'Pending'"))
  @@map("certificates")
}

model ProcessedCompletionEvent {
  eventId String @id @map("event_id") @db.Uuid
  certificateId String @map("certificate_id") @db.Uuid
  fingerprint String @db.VarChar(64)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  @@map("processed_completion_events")
}

model CompletionEventQuarantine {
  id String @id @default(uuid(7)) @db.Uuid
  topic String
  partition Int
  offset BigInt
  eventId String? @map("event_id")
  reason String @db.VarChar(64)
  payload Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz
  @@unique([topic, partition, offset])
  @@map("completion_event_quarantine")
}

model EvaluationForm {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  certificateId  String    @unique @map("certificate_id") @db.Uuid
  enrollmentId   String    @unique @map("enrollment_id") @db.Uuid
  learnerId      String    @map("learner_id") @db.Uuid
  courseId       String    @map("course_id") @db.Uuid
  openedAt       DateTime  @map("opened_at") @db.Timestamptz
  dueAt          DateTime  @map("due_at") @db.Timestamptz
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  certificate Certificate @relation(fields: [certificateId], references: [id])

  @@index([organizationId, learnerId])
  @@map("evaluation_forms")
}

model EvaluationResponse {
  id                String  @id @default(uuid(4)) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  courseId          String  @map("course_id") @db.Uuid
  contentUsefulness Int     @map("content_usefulness") @db.SmallInt
  difficultyFit     Int     @map("difficulty_fit") @db.SmallInt
  materialQuality   Int     @map("material_quality") @db.SmallInt
  comment           String? @db.VarChar(2000)

  @@index([organizationId, courseId])
  @@map("evaluation_responses")
}

model ReportExport {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestedBy    String    @map("requested_by") @db.Uuid
  requesterRole  String    @map("requester_role")
  reportType     String    @map("report_type")
  fileFormat     String    @map("file_format")
  filters        Json
  status         String
  attempts       Int       @default(0)
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz
  fileKey        String?   @map("file_key")
  fileSizeBytes  BigInt?   @map("file_size_bytes")
  errorMessage   String?   @map("error_message")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId, requestedBy, status])
  @@map("report_exports")
}

model PlatformSetting {
  id                 String   @id @default(uuid(7)) @db.Uuid
  evaluationFormDays Int      @default(14) @map("evaluation_form_days")
  sourceAsOf         DateTime @map("source_as_of") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}

model CertificateSignerSetting {
  organizationId     String   @id @map("organization_id") @db.Uuid
  signerName         String   @map("signer_name") @db.VarChar(100)
  signerTitle        String   @map("signer_title") @db.VarChar(200)
  signatureAssetKey  String?  @map("signature_asset_key")
  signatureHash      String?  @map("signature_hash") @db.VarChar(64)
  signatureMime      String?  @map("signature_mime")
  signatureSizeBytes Int?     @map("signature_size_bytes")
  version            Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy          String   @map("updated_by") @db.Uuid

  @@map("certificate_signer_settings")
}

model StorageCleanupTask {
  id            String    @id @default(uuid(7)) @db.Uuid
  assetKey      String    @unique @map("asset_key")
  reason        String    @db.VarChar(80)
  notBefore     DateTime  @map("not_before") @db.Timestamptz
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(80)
  nextAttemptAt DateTime  @map("next_attempt_at") @db.Timestamptz
  leaseToken    String?   @map("lease_token") @db.Uuid
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([nextAttemptAt, notBefore], map: "ix_storage_cleanup_due")
  @@map("storage_cleanup_tasks")
}
