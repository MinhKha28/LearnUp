# Copy to .env (never commit .env). Values below match docker-compose.yml defaults.
PORT=8086
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessment_db?schema=public
# Must equal INTERNAL_SERVICE_KEY of course-service (sent as x-internal-key).
INTERNAL_SERVICE_KEY=learnup-internal-secret

# Course Service (owner / status / Locked flag of a Course)
COURSE_SERVICE_URL=http://localhost:8083
COURSE_SERVICE_TIMEOUT_MS=5000
# http (default) | fake (no Course Service; treats every Course as the caller's own, local work only)
COURSE_CLIENT_MODE=http
# fake mode only
# FAKE_COURSE_STATUS=Draft
# FAKE_COURSE_LOCKED=false

# Learning Service (is the Learner enrolled in the Course, UC29 / UC30)
LEARNING_SERVICE_URL=http://localhost:8085
LEARNING_SERVICE_TIMEOUT_MS=5000
# http (default) | fake (every Learner counts as enrolled in every Course, local work only)
ENROLLMENT_CLIENT_MODE=http

# Tenant Service (learner names on the Instructor submission screens, UC32)
TENANT_SERVICE_URL=http://localhost:8084
TENANT_SERVICE_TIMEOUT_MS=5000
# http (default) | fake (generated learner names, local work only)
TENANT_CLIENT_MODE=http

# Prompt files of Assignments (BR-320) go to Cloudinary through @learnup/ts-storage (same account as course-service).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# UC19: before a prompt file is attached, ask the storage (HEAD) that it exists and take its real size. off = skip (dev without storage).
PROMPT_FILE_VERIFY=on
