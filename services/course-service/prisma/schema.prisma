generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OrganizationQuotaLock {
  organizationId String   @id @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("organization_quota_locks")
}

model CourseChain {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  instructorId   String   @map("instructor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  courses Course[]

  @@index([organizationId, instructorId])
  @@map("course_chains")
}

model Course {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  chainId                String    @map("chain_id") @db.Uuid
  versionNumber          Int       @map("version_number")
  name                   String    @db.VarChar(200)
  shortDescription       String?   @map("short_description") @db.VarChar(500)
  trainingObjectives     String?   @map("training_objectives") @db.VarChar(2000)
  learningOutcomes       String[]  @map("learning_outcomes") @db.VarChar(200)
  coverFileId            String?   @map("cover_file_id") @db.Uuid
  expectedCompletionDays Int       @map("expected_completion_days")
  courseType             String    @map("course_type")
  status                 String
  lockedAt               DateTime? @map("locked_at") @db.Timestamptz
  submittedAt            DateTime? @map("submitted_at") @db.Timestamptz
  publishedAt            DateTime? @map("published_at") @db.Timestamptz
  archivedAt             DateTime? @map("archived_at") @db.Timestamptz
  rejectedAt             DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason        String?   @map("rejection_reason") @db.VarChar(1000)
  disabledAt             DateTime? @map("disabled_at") @db.Timestamptz
  disabledReason         String?   @map("disabled_reason") @db.VarChar(1000)
  assignmentMinutes      Int       @default(0) @map("assignment_minutes")
  assignmentMinutesAsOf  DateTime? @map("assignment_minutes_as_of") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  chain     CourseChain     @relation(fields: [chainId], references: [id], onDelete: Cascade)
  coverFile MediaFile?      @relation("CourseCover", fields: [coverFileId], references: [id])
  modules   CourseModule[]
  reports   ContentReport[]

  @@unique([chainId, versionNumber])
  @@index([organizationId, status])
  @@map("courses")
}

model CourseModule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  title          String   @db.VarChar(200)
  position       Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([organizationId, courseId])
  @@map("modules")
}

model Lesson {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  moduleId         String    @map("module_id") @db.Uuid
  title            String    @db.VarChar(200)
  content          String    @db.VarChar(20000)
  position         Int
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz
  disabledReportId String?   @map("disabled_report_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials Material[]

  @@unique([moduleId, position])
  @@index([organizationId, moduleId])
  @@map("lessons")
}

model Material {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  materialType     String    @map("material_type")
  title            String    @db.VarChar(200)
  isRequired       Boolean   @map("is_required")
  fileId           String    @map("file_id") @db.Uuid
  position         Int
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz
  disabledReportId String?   @map("disabled_report_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  lesson Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file   MediaFile @relation(fields: [fileId], references: [id])

  @@unique([lessonId, position])
  @@index([organizationId, fileId])
  @@map("materials")
}

model MediaFile {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  purpose          String
  status           String
  storageKey       String    @unique @map("storage_key")
  originalFilename String    @map("original_filename") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(255)
  sizeBytes        BigInt    @map("size_bytes")
  durationSeconds  Int?      @map("duration_seconds")
  wordCount        Int?      @map("word_count")
  deliveryType     String    @default("upload") @map("delivery_type")
  storageFormat    String    @default("") @map("storage_format")
  readyAt          DateTime? @map("ready_at") @db.Timestamptz
  releasedAt       DateTime? @map("released_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  materials Material[]
  covers    Course[]   @relation("CourseCover")

  @@index([organizationId, status])
  @@map("media_files")
}

model ContentReport {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  courseId            String    @map("course_id") @db.Uuid
  targetType          String    @map("target_type")
  targetId            String    @map("target_id") @db.Uuid
  ownerInstructorId   String    @map("owner_instructor_id") @db.Uuid
  reporterId          String    @map("reporter_id") @db.Uuid
  reason              String    @db.VarChar(1000)
  level               String
  status              String
  dueAt               DateTime  @map("due_at") @db.Timestamptz
  orgDecision         String?   @map("org_decision")
  orgSeverity         String?   @map("org_severity")
  orgDecisionReason   String?   @map("org_decision_reason") @db.VarChar(1000)
  orgDecidedBy        String?   @map("org_decided_by") @db.Uuid
  orgDecidedAt        DateTime? @map("org_decided_at") @db.Timestamptz
  escalationType      String?   @map("escalation_type")
  escalationReason    String?   @map("escalation_reason") @db.VarChar(1000)
  escalatedBy         String?   @map("escalated_by") @db.Uuid
  escalatedAt         DateTime? @map("escalated_at") @db.Timestamptz
  adminDecision       String?   @map("admin_decision")
  adminSeverity       String?   @map("admin_severity")
  adminDecisionReason String?   @map("admin_decision_reason") @db.VarChar(1000)
  adminDecidedBy      String?   @map("admin_decided_by") @db.Uuid
  adminDecidedAt      DateTime? @map("admin_decided_at") @db.Timestamptz
  revisionRequestedAt DateTime? @map("revision_requested_at") @db.Timestamptz
  reviewRequestedAt   DateTime? @map("review_requested_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([targetType, targetId])
  @@map("content_reports")
}

model PlatformSetting {
  id                           String   @id @default(uuid(7)) @db.Uuid
  sourceAsOf                   DateTime @map("source_as_of") @db.Timestamptz
  readingSpeedWordsPerMinute   Int      @default(200) @map("reading_speed_words_per_minute")
  studyMinutesPerDay           Int      @default(60) @map("study_minutes_per_day")
  durationGapThresholdPercent  Int      @default(20) @map("duration_gap_threshold_percent")
  maxVideoSizeBytes            BigInt   @default(2147483648) @map("max_video_size_bytes")
  maxVideoDurationMinutes      Int      @default(120) @map("max_video_duration_minutes")
  maxReadingSizeBytes          BigInt   @default(52428800) @map("max_reading_size_bytes")
  allowedVideoMimeTypes        String[] @default(["video/mp4"]) @map("allowed_video_mime_types")
  allowedReadingMimeTypes      String[] @default(["application/pdf"]) @map("allowed_reading_mime_types")
  reportHandlingDays           Int      @default(7) @map("report_handling_days")
  instructorViolationThreshold Int      @default(3) @map("instructor_violation_threshold")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}

model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type")
  organizationId String?   @map("organization_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([publishedAt])
  @@map("outbox_events")
}
