PORT=8083
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/course_db?schema=public"
# Required: a private random key, at least 32 bytes, the same in every service. Uncomment it and set the output of `openssl rand -hex 32`.
# Do not leave it set to an empty value: an empty key must never be a valid key.
# INTERNAL_SERVICE_KEY=<output of: openssl rand -hex 32>
TENANT_SERVICE_URL=http://localhost:8084
LEARNING_SERVICE_URL=http://localhost:8085
ASSESSMENT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8082

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Storage defaults are the Cloudinary Free plan (bytes); empty uses defaults.
STORAGE_MAX_RAW_BYTES=
STORAGE_MAX_IMAGE_BYTES=
STORAGE_MAX_VIDEO_BYTES=

KAFKA_BROKERS=localhost:9092
OUTBOX_RELAY_ENABLED=false
OUTBOX_TOPIC=learnup.course.course-component-events
OUTBOX_REPLICATION_FACTOR=1

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_DELIVERY_TIMEOUT_MS=10000
# Must be >= 2 * delivery timeout, > 5000ms and <= 30000ms.
OUTBOX_TRANSACTION_TIMEOUT_MS=30000
OUTBOX_PROBE_TIMEOUT_MS=1000

OUTBOX_BACKOFF_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000
OUTBOX_ALERT_ATTEMPTS=10

# Reading PDF text extraction (worker thread). Empty = default.
# Hard deadline per parse in ms (default 30000).
READING_PDF_PARSE_TIMEOUT_MS=
# Worker old-generation heap limit in MiB (default 256).
READING_PDF_PARSE_MAX_OLD_GENERATION_MB=
