PORT=8083
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/course_db?schema=public"
INTERNAL_SERVICE_KEY=learnup-internal-secret
TENANT_SERVICE_URL=http://localhost:8084
LEARNING_SERVICE_URL=http://localhost:8085
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Storage defaults are the Cloudinary Free plan (bytes); empty uses defaults.
STORAGE_MAX_RAW_BYTES=
STORAGE_MAX_IMAGE_BYTES=
STORAGE_MAX_VIDEO_BYTES=

KAFKA_BROKERS=localhost:9092
OUTBOX_RELAY_ENABLED=false
OUTBOX_TOPIC=learnup.course.course-component-events
OUTBOX_REPLICATION_FACTOR=1

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_DELIVERY_TIMEOUT_MS=10000
OUTBOX_TRANSACTION_TIMEOUT_MS=30000
OUTBOX_PROBE_TIMEOUT_MS=1000

OUTBOX_BACKOFF_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000
OUTBOX_ALERT_ATTEMPTS=10