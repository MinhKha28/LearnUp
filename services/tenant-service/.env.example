PORT=
DATABASE_URL=
INTERNAL_SERVICE_KEY=
FRONTEND_URL=
IDENTITY_SERVICE_URL=
# Thời gian chờ tối đa một lời gọi identity (ms); UC02 giữ khóa theo email trong khoảng này
IDENTITY_SERVICE_TIMEOUT_MS=8000
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_TIMEOUT_MS=5000
# Chỉ development mới in email ra log khi NOTIFICATION_SERVICE_URL trống; thiếu NODE_ENV coi như production (email giữ lại, không in nội dung).
NODE_ENV=development
# UC12 - TẠM THỜI: fake danh tính khi chưa đi qua api-gateway (src/common/middleware/dev-fake-auth.middleware.ts).
# true = bật (chỉ khi NODE_ENV khác production). Mặc định tắt.
DEV_FAKE_AUTH=true
# UC12 - nguồn số Course Instructor phụ trách: fake (mặc định, dữ liệu giả) | http (gọi course-service thật)
COURSE_CLIENT_MODE=
COURSE_SERVICE_URL=
COURSE_SERVICE_TIMEOUT_MS=
# UC13 - nguồn tình trạng đào tạo của Learner: fake (mặc định, dữ liệu giả) | http (gọi learning-service thật)
LEARNING_CLIENT_MODE=fake
LEARNING_SERVICE_URL=http://localhost:8085
LEARNING_SERVICE_TIMEOUT_MS=3000
# BR-337, tenant_db mục 3.5: khóa HMAC băm mã xác thực email. Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_OTP_SECRET=
# Cloudinary - lưu file (logo tổ chức, ảnh đại diện); dùng bởi src/infrastructure/storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

