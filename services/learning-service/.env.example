PORT=8085
ENROLLMENT_RATE_LIMIT_PER_MINUTE=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_db?schema=public"
INTERNAL_SERVICE_KEY=learnup-internal-secret

# course-service (REST nội bộ I1–I4); INTERNAL_SERVICE_KEY phải trùng với course-service
COURSE_SERVICE_URL=http://localhost:8083
COURSE_SERVICE_TIMEOUT_MS=3000

# Trạng thái truy cập tổ chức: chỉ dùng fake ở dev (http sẽ từ chối khởi động)
TENANT_CLIENT_MODE=fake
TENANT_FAKE_TIMEZONE=Asia/Ho_Chi_Minh

# Lookup Learner luôn dùng HTTP, độc lập với chế độ kiểm subscription ở trên
TENANT_SERVICE_URL=http://localhost:8082
TENANT_SERVICE_TIMEOUT_MS=3000
