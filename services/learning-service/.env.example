PORT=8085
VIDEO_PLAYBACK_MODE=course
# VIDEO_FIXTURE_URL chỉ dùng khi VIDEO_PLAYBACK_MODE=fixture, không dùng production
VIDEO_FIXTURE_URL=
ENROLLMENT_RATE_LIMIT_PER_MINUTE=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_db?schema=public"
INTERNAL_SERVICE_KEY=learnup-internal-secret

# course-service (REST nội bộ I1–I4); INTERNAL_SERVICE_KEY phải trùng với course-service
COURSE_SERVICE_URL=http://localhost:8083
COURSE_SERVICE_TIMEOUT_MS=3000

# Trạng thái truy cập tổ chức: chỉ dùng fake ở dev (http sẽ từ chối khởi động)
TENANT_CLIENT_MODE=fake
TENANT_FAKE_TIMEZONE=Asia/Ho_Chi_Minh

# Assessment activity: fake cho dev; http theo hợp đồng nội bộ đề xuất với assessment-service
ASSESSMENT_CLIENT_MODE=fake
ASSESSMENT_FAKE_RESULT_COURSE_IDS=
ASSESSMENT_SERVICE_URL=http://localhost:8086
ASSESSMENT_SERVICE_TIMEOUT_MS=3000

# Lookup Learner luôn dùng HTTP, độc lập với chế độ kiểm subscription ở trên
TENANT_SERVICE_URL=http://localhost:8084
TENANT_SERVICE_TIMEOUT_MS=3000

# Learning outbox relay (disabled by default for unrelated tests)
KAFKA_BROKERS=localhost:9092
OUTBOX_RELAY_ENABLED=false
OUTBOX_TOPIC=learnup.learning.enrollment-events
OUTBOX_REPLICATION_FACTOR=1
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_DELIVERY_TIMEOUT_MS=10000
OUTBOX_TRANSACTION_TIMEOUT_MS=30000
OUTBOX_PROBE_TIMEOUT_MS=1000
OUTBOX_BACKOFF_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000
OUTBOX_ALERT_ATTEMPTS=10

# Course completion (snapshot endpoint is not yet supplied by assessment)
COMPLETION_WORKER_ENABLED=true
COMPLETION_LEASE_MS=30000
COMPLETION_POLL_MS=1000
COMPLETION_BATCH_SIZE=5
COMPLETION_CONCURRENCY=5
COMPLETION_TRANSACTION_MS=5000
COMPLETION_BACKOFF_MS=1000
COMPLETION_BACKOFF_MAX_MS=300000
ASSESSMENT_COMPLETION_CLIENT_MODE=http
ASSESSMENT_COMPLETION_TIMEOUT_MS=3000
# Harness-only phase probes; not imported by the production application.
COMPLETION_PERF_PHASES=false

# Reading content: course returns 503 until C10 supplies the access contract.
# fixture is development/test only and is rejected in production.
READING_ACCESS_MODE=course
# READING_FIXTURE_URL=https://example.test/reading-fixture.pdf
