{
  "name": "@learnup/common-ts",
  "version": "1.0.0",
  "description": "Shared cross-cutting TypeScript models, contracts, context, and NestJS adapters for LearnUP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./response": {
      "types": "./dist/response/index.d.ts",
      "default": "./dist/response/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "default": "./dist/pagination/index.js"
    },
    "./exception": {
      "types": "./dist/exception/index.d.ts",
      "default": "./dist/exception/index.js"
    },
    "./correlation": {
      "types": "./dist/correlation/index.d.ts",
      "default": "./dist/correlation/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    },
    "./kafka": {
      "types": "./dist/kafka/index.d.ts",
      "default": "./dist/kafka/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./adapters/nestjs": {
      "types": "./dist/adapters/nestjs/index.d.ts",
      "default": "./dist/adapters/nestjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "rxjs": "^7.8.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
