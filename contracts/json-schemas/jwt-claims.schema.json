{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.learnup.com/json-schemas/jwt-claims.schema.json",
  "title": "LearnUP JWT Claims Contract",
  "description": "Standardized JWT claims payload contract issued by Identity Service and validated at API Gateway perimeter.",
  "type": "object",
  "required": [
    "sub",
    "role",
    "organizationId",
    "iat",
    "exp"
  ],
  "properties": {
    "sub": {
      "type": "string",
      "description": "Subject identifier representing the unique User ID.",
      "examples": ["usr_01HGB98A76B5F4E3D2C1"]
    },
    "role": {
      "$ref": "./roles.schema.json",
      "description": "The user's canonical platform role governing RBAC privileges."
    },
    "organizationId": {
      "type": "string",
      "description": "The standardized tenant organization identifier.",
      "examples": ["org_01HGB7398A1B2C3D4E5"]
    },
    "iat": {
      "type": "integer",
      "description": "Issued at timestamp (seconds since Unix epoch).",
      "examples": [1726113600]
    },
    "exp": {
      "type": "integer",
      "description": "Expiration timestamp (seconds since Unix epoch).",
      "examples": [1726117200]
    },
    "iss": {
      "type": "string",
      "description": "Issuer identifier.",
      "default": "learnup-identity-service",
      "examples": ["learnup-identity-service"]
    },
    "aud": {
      "type": "string",
      "description": "Audience identifier.",
      "default": "learnup-platform",
      "examples": ["learnup-platform"]
    }
  },
  "additionalProperties": false
}
