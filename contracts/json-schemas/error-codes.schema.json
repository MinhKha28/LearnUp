{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.learnup.com/json-schemas/error-codes.schema.json",
  "title": "LearnUP Standard Error Code Catalog",
  "description": "Enumeration of machine-readable error codes standardized across all LearnUP services.",
  "type": "string",
  "enum": [
    "INVALID_INPUT",
    "UNAUTHORIZED",
    "FORBIDDEN",
    "RESOURCE_NOT_FOUND",
    "CONFLICT",
    "RATE_LIMITED",
    "INTERNAL_ERROR",
    "SERVICE_UNAVAILABLE"
  ]
}
