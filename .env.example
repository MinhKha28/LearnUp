# Required for the full stack. Set private values in the ignored .env.
DB_PASSWORD=
JWT_SECRET=
# Set a private, non-default key of at least 32 UTF-8 bytes. Prefer 32 random bytes encoded as hex.
INTERNAL_SERVICE_KEY=
EMAIL_OTP_SECRET=
PASSWORD_RECOVERY_FRONTEND_BASE_URL=http://localhost:3000
# Compose development frontend URL; set the public frontend URL in production.
LEARNUP_FRONTEND_BASE_URL=http://localhost:3000

# Achievement source topic and bounded metadata rediscovery interval (milliseconds).
CERTIFICATE_KAFKA_TOPIC=learnup.learning.enrollment-events
CERTIFICATE_METADATA_MAX_AGE_MS=5000
