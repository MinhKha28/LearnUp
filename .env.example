# ==============================================================================
# LearnUP Platform - Environment Variables Template (.env.example)
# Copy this file to .env and customize values for your environment.
# ==============================================================================

# PostgreSQL Database Credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_PORT=5433

# API Gateway Host Port Exposure (8088 prevents collision with host port 8080)
GATEWAY_HOST_PORT=8088

# Security & JWT Configuration (Must be at least 32 bytes)
JWT_SECRET=devSecretKeyForLearnUpPlatformMustBeAtLeast32BytesLong

# Internal Inter-Service Key (Must match across Gateway and all backend services)
INTERNAL_GATEWAY_KEY=learnup-internal-secret
INTERNAL_SERVICE_KEY=learnup-internal-secret

# Demo Account Seeding (Opt-in for Development environments only)
LEARNUP_SEED_ENABLED=true
LEARNUP_SEED_DEFAULT_PASSWORD=LearnUp@123

# Email OTP Secret for Tenant Service
EMAIL_OTP_SECRET=devEmailOtpSecretMustBe32BytesLong123456

# Notification Service - SMTP Mail Configuration (Optional in development)
# Set LEARNUP_MAIL_ENABLED=true to send physical emails via SMTP
LEARNUP_MAIL_ENABLED=false
LEARNUP_MAIL_FROM=noreply@learnup.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Cloudinary Storage Configuration (Optional for startup; required only for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gateway CORS Whitelist
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173